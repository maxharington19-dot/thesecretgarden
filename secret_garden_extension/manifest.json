{
  "manifest_version": 3,
  "name": "Secret Garden Extension",
  "version": "2.0.0",
  "description": "Enables the secret garden to work (blocks popups) and pulls its rules from a remote config so behavior updates without reinstalling.",
  "permissions": [
    "scripting",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
