{
  "version": 3,
  "updated": "2026-08-08",
  "note": "Remote behavior config for the Secret Garden extension. Edit and commit to deploy new rules to all installed extensions within ~30 min. No reinstall needed unless permissions or code change. Proven-good CDN header set is Referer-only with the Origin removed (segments 403 when a browser Origin is present).",
  "popupBlockPatterns": [
    "vidsrcme",
    "vidsrc",
    "autoembed",
    "cloudnestra",
    "2embed",
    "yesmovies",
    "player4u",
    "vidlink"
  ],
  "headerRules": [
    {
      "urlFilter": "*.m3u8*",
      "removeOrigin": true,
      "referer": "https://cloudorchestranova.com/",
      "resourceTypes": ["media", "xmlhttprequest", "other"]
    },
    {
      "urlFilter": "*/content/*",
      "removeOrigin": true,
      "referer": "https://cloudorchestranova.com/",
      "resourceTypes": ["media", "xmlhttprequest", "other"]
    },
    {
      "urlFilter": "*/generate.php*",
      "removeOrigin": true,
      "referer": "https://cloudorchestranova.com/",
      "resourceTypes": ["xmlhttprequest", "other"]
    },
    {
      "urlFilter": "*api.opensubtitles.com*",
      "userAgent": "secret-garden v1",
      "resourceTypes": ["xmlhttprequest", "other"]
    }
  ]
}
